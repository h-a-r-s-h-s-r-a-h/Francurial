PROXY="paste-your-proxy"
OPENROUTER_KEY="paste-your-key"
MODEL="openai/gpt-5.4"

# --- Postgres ---
POSTGRES_USER=francurial
POSTGRES_PASSWORD=francurial_local_dev
POSTGRES_DB=francurial
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://francurial:francurial_local_dev@postgres:5432/francurial

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Gateway ---
GATEWAY_PORT=8000
API_KEYS="dev-local-key-change-me"
LIVE_URL_SECRET="change-me-live-url-hmac-secret"
LIVE_URL_TTL_SECONDS=7200
WEBHOOK_HMAC_SECRET="change-me-webhook-hmac-secret"
PUBLIC_BASE_URL="http://localhost:8000"

# --- Worker ---
WORKER_INTERNAL_PORT=9000
GATEWAY_INTERNAL_URL="http://gateway:8000"
MAX_AGENT_STEPS=40
CAPTCHA_SOLVE_ATTEMPTS=2
WORKER_CONCURRENCY=1

# --- Credential/proxy at-rest encryption (Fernet key, local dev only — rotate for prod) ---
CREDENTIALS_ENC_KEY="MIWxJgGx39y6-XK4fWeW-MT57c0emzslhHF8yqBtkrg="

# --- Internal worker<->gateway auth (defense-in-depth; also keep these ports
# off any public ingress / restrict via NetworkPolicy in k8s) ---
