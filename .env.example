# Copy this file to .env and fill in real values. Never commit the real .env.

# Comma-separated pool of "host:port:username:password" proxies, used
# round-robin when a task doesn't supply its own "proxy" field. Leave empty
# to require every task to bring its own proxy.
PROXY="host1:port1:user1:pass1,host2:port2:user2:pass2"

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_KEY="sk-or-v1-..."

# Default reasoning model when a task doesn't override "model" in its request
MODEL="openai/gpt-5.4"

# --- Postgres ---
POSTGRES_USER=francurial
POSTGRES_PASSWORD=change-me
POSTGRES_DB=francurial
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://francurial:change-me@postgres:5432/francurial

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Gateway ---
GATEWAY_PORT=8000
# Comma-separated list of valid X-API-Key values callers must send
API_KEYS="dev-local-key-change-me"
# Random secret used to HMAC-sign live_url tokens — generate your own
LIVE_URL_SECRET="change-me-live-url-hmac-secret"
LIVE_URL_TTL_SECONDS=7200
# Random secret used to HMAC-sign webhook delivery payloads — generate your own
WEBHOOK_HMAC_SECRET="change-me-webhook-hmac-secret"
PUBLIC_BASE_URL="http://localhost:8000"

# --- Worker ---
WORKER_INTERNAL_PORT=9000
GATEWAY_INTERNAL_URL="http://gateway:8000"
MAX_AGENT_STEPS=40
CAPTCHA_SOLVE_ATTEMPTS=2
WORKER_CONCURRENCY=1

# --- Credential/proxy at-rest encryption ---
# Fernet key — generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENC_KEY="generate-your-own-fernet-key"

# --- Internal worker<->gateway auth (defense-in-depth; also keep these ports
# off any public ingress / restrict via NetworkPolicy in k8s) ---
INTERNAL_SHARED_SECRET="change-me-internal-shared-secret"
